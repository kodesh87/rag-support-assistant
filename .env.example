# OpenAI API key used for chat completions and embeddings
OPENAI_API_KEY=

# Supabase project credentials (used as the pgvector-backed vector store)
SUPABASE_API_KEY=
SUPABASE_URL_LC_CHATBOT=

# Optional: override the FAQ source file used by `npm run ingest`
# Defaults to data/sample-faq.txt
# FAQ_FILE_PATH=

# Optional: port for the Express server (defaults to 3000)
# PORT=3000
